* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --green: #176b3a;
  --dark-green: #0b4324;
  --light-green: #e9f2eb;
  --cream: #f8f6ef;
  --gold: #c9973e;
  --text: #173321;
  --muted: #777;
  --white: #ffffff;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #fff;
  color: var(--text);
}


/* =========================
   NAVBAR
========================= */

.navbar {
  height: 74px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6%;
  background: rgba(255,255,255,.96);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid #eee;
}

.logo {
  color: var(--green);
  font-size: 23px;
  font-weight: 900;
  letter-spacing: 2px;
}

.logo span {
  display: block;
  font-size: 8px;
  letter-spacing: 4px;
  color: var(--gold);
  text-align: center;
}

.navbar nav {
  display: flex;
  gap: 30px;
}

.navbar nav a {
  text-decoration: none;
  color: #333;
  font-size: 14px;
  font-weight: 600;
}

.navbar nav a:hover {
  color: var(--green);
}

.cart-top {
  border: none;
  background: var(--green);
  color: white;
  padding: 11px 18px;
  border-radius: 25px;
  font-weight: bold;
  cursor: pointer;
}

.cart-top span {
  background: white;
  color: var(--green);
  border-radius: 50%;
  padding: 2px 6px;
  margin-left: 4px;
}


/* =========================
   HERO
========================= */

.hero {
  min-height: 570px;

  background:
    radial-gradient(circle at 15% 30%, #eef5ed 0, transparent 28%),
    radial-gradient(circle at 85% 60%, #edf5ed 0, transparent 30%),
    #fff;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 55px 7%;
  overflow: hidden;

  position: relative;
}


/* TEXT SIDE */

.hero-content {
  width: 48%;
  position: relative;
  z-index: 10;
  flex-shrink: 0;
}


/* IMAGE SIDE */

.hero-food {
  width: 47%;
  min-width: 0;

  position: relative;
  z-index: 2;

  display: flex;
  justify-content: center;
  align-items: center;

  overflow: visible;
}


/* GREEN BACK CIRCLE */

.hero-food .food-circle {
  position: absolute;

  width: 430px;
  height: 430px;

  background: #edf4eb;

  border-radius: 50%;

  z-index: 0;
}


/* HERO IMAGE */

.hero-food img {
  display: block;

  width: min(500px, 100%);
  height: 420px;

  object-fit: cover;

  /* SAME CURVE */
  border-radius: 45% 45% 45% 45%;

  position: relative;
  z-index: 2;

  mix-blend-mode: multiply;

  /* prevents image from entering text area */
  max-width: 100%;
}


/* HERO TEXT */

.small-title {
  color: var(--gold);
  font-size: 12px;
  letter-spacing: 4px;
  font-weight: bold;
  margin-bottom: 18px;
}

.hero h1 {
  font-family: Georgia, serif;
  font-size: clamp(55px, 7vw, 90px);
  line-height: .9;
  color: #172719;
  position: relative;
  z-index: 11;
}

.hero h1 span {
  color: var(--green);
  font-style: italic;
}

.hero p {
  margin-top: 25px;
  color: #666;
  max-width: 420px;
  line-height: 1.7;

  position: relative;
  z-index: 11;
}

.main-btn {
  margin-top: 28px;
  background: var(--green);
  color: white;
  border: none;
  padding: 15px 28px;
  border-radius: 30px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(23,107,58,.2);

  position: relative;
  z-index: 11;
}

.main-btn:hover {
  background: var(--dark-green);
}


/* =========================
   CUSTOMER
========================= */

.customer-section {
  padding: 20px 8%;
}

.customer-card {
  max-width: 1100px;
  margin: auto;
  background: var(--light-green);
  padding: 22px 28px;
  border-radius: 20px;

  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 20px;
}

.section-mini,
.customer-card span {
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: bold;
}

.customer-card h2 {
  margin-top: 5px;
}

.customer-inputs {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.customer-inputs input {
  width: 170px;
  padding: 12px;
  border: 1px solid #cbd8ce;
  border-radius: 9px;
  outline: none;
}

.green-btn {
  border: none;
  background: var(--green);
  color: white;
  padding: 12px 20px;
  border-radius: 9px;
  font-weight: bold;
  cursor: pointer;
}


/* =========================
   SECTIONS
========================= */

section {
  scroll-margin-top: 90px;
}

.section-heading {
  text-align: center;
  margin-bottom: 35px;
}

.section-heading span {
  color: var(--gold);
  font-size: 11px;
  letter-spacing: 3px;
  font-weight: bold;
}

.section-heading h2 {
  font-family: Georgia, serif;
  font-size: 40px;
  margin-top: 7px;
  color: #173321;
}

.section-heading p {
  color: #777;
  margin-top: 10px;
}


/* =========================
   CATEGORIES
========================= */

.categories-section {
  padding: 65px 7%;
  background: #fff;
}

.category-row {
  max-width: 1000px;
  margin: auto;

  display: flex;
  justify-content: center;
  gap: 35px;
  flex-wrap: wrap;
}

.category {
  text-align: center;
  width: 120px;
}

.category-icon {
  width: 85px;
  height: 85px;
  margin: auto;

  border-radius: 50%;
  background: var(--light-green);

  display: flex;
  justify-content: center;
  align-items: center;

  font-size: 38px;

  border: 4px solid white;
  box-shadow: 0 5px 20px rgba(0,0,0,.08);
}

.category h3 {
  margin-top: 10px;
  font-size: 14px;
}

.category p {
  margin-top: 4px;
  color: #999;
  font-size: 11px;
}


/* =========================
   MENU
========================= */

.menu-section {
  background: var(--cream);
  padding: 75px 7%;
}

.menu-grid {
  max-width: 1100px;
  margin: auto;

  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(240px, 1fr));

  gap: 25px;
}

.menu-card {
  background: #fff;
  border-radius: 18px;
  overflow: hidden;

  box-shadow: 0 8px 25px rgba(0,0,0,.07);

  transition: .25s;
  border: 1px solid #eee;
}

.menu-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 30px rgba(0,0,0,.1);
}

.menu-image {
  height: 170px;
  background: var(--light-green);

  display: flex;
  justify-content: center;
  align-items: center;

  font-size: 75px;
}

.menu-info {
  padding: 20px;
}

.menu-info h3 {
  color: var(--green);
  font-size: 19px;
}

.menu-info p {
  color: #888;
  font-size: 12px;
  margin-top: 7px;
}

.menu-price {
  font-size: 20px;
  font-weight: bold;
  margin: 15px 0;
}

.menu-add {
  width: 100%;
  border: none;
  background: var(--green);
  color: white;
  padding: 12px;
  border-radius: 9px;
  cursor: pointer;
  font-weight: bold;
}

.menu-add:hover {
  background: var(--dark-green);
}

.sold-out {
  color: #b3261e;
  font-weight: bold;
}


/* =========================
   CART
========================= */

.cart-section {
  padding: 70px 7%;
  background: white;
}

.cart-card {
  max-width: 1000px;
  margin: auto;

  background: var(--light-green);

  border-radius: 25px;
  padding: 30px;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-header span,
.credit-card span {
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: bold;
}

.cart-header h2 {
  margin-top: 6px;
}

.cart-total-top {
  color: var(--green);
  font-size: 24px;
  font-weight: bold;
}

.cart-items {
  margin-top: 20px;
}

.cart-item {
  background: white;
  padding: 15px;
  border-radius: 12px;
  margin-bottom: 10px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;
}

.qty {
  display: flex;
  align-items: center;
  gap: 8px;
}

.qty button {
  border: none;
  background: var(--light-green);
  color: var(--green);

  width: 30px;
  height: 30px;

  border-radius: 50%;

  font-weight: bold;
  cursor: pointer;
}

.remove-btn {
  border: none;
  background: transparent;
  color: #b3261e;
  cursor: pointer;
}

.cart-bottom {
  border-top: 1px solid #cbd8ce;

  margin-top: 20px;
  padding-top: 20px;

  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-bottom small {
  display: block;
  color: #888;
}

.cart-bottom strong {
  display: block;
  color: var(--green);
  font-size: 25px;
  margin-top: 5px;
}

.payment-buttons {
  display: flex;
  gap: 10px;
}

.pay-btn,
.credit-btn {
  border: none;
  padding: 13px 20px;
  border-radius: 10px;
  font-weight: bold;
  cursor: pointer;
}

.pay-btn {
  background: var(--green);
  color: white;
}

.credit-btn {
  background: var(--gold);
  color: white;
}


/* =========================
   CREDIT
========================= */

.credit-section {
  padding: 30px 7% 70px;
}

.credit-card {
  max-width: 1000px;
  margin: auto;

  background: var(--dark-green);
  color: white;

  border-radius: 25px;
  padding: 30px;

  display: flex;
  justify-content: space-between;
  align-items: center;
}

.credit-card h2 {
  margin-top: 6px;
}

.credit-details {
  display: flex;
  gap: 45px;
}

.credit-details small {
  display: block;
  opacity: .65;
  font-size: 10px;
}

.credit-details strong {
  display: block;
  margin-top: 6px;
  font-size: 20px;
}

.credit-details .available strong {
  color: #b8e7c5;
}


/* =========================
   ORDERS
========================= */

.orders-section {
  padding: 70px 7%;
  background: var(--cream);
}

.order-card {
  max-width: 1000px;
  margin: 10px auto;

  background: white;

  padding: 18px 20px;

  border-radius: 12px;
  border-left: 5px solid var(--green);

  box-shadow: 0 3px 12px rgba(0,0,0,.05);
}

.order-status {
  color: var(--green);
  font-weight: bold;
}

.empty-cart,
.empty-orders,
.loading {
  text-align: center;
  padding: 30px;
  color: #888;
}


/* =========================
   FOOTER
========================= */

footer {
  background: var(--dark-green);
  color: white;

  text-align: center;

  padding: 45px 20px;
}

.footer-logo {
  font-size: 25px;
  letter-spacing: 4px;
  font-weight: bold;
}

footer p {
  margin-top: 8px;
  opacity: .7;
}

.footer-line {
  height: 1px;
  background: rgba(255,255,255,.15);

  max-width: 400px;
  margin: 25px auto;
}

footer small {
  opacity: .5;
}


/* =========================
   MESSAGE
========================= */

#message {
  position: fixed;

  bottom: 25px;
  left: 50%;

  transform: translateX(-50%);

  background: var(--dark-green);
  color: white;

  padding: 14px 22px;

  border-radius: 30px;

  display: none;

  z-index: 999;

  box-shadow: 0 8px 25px rgba(0,0,0,.2);
}


/* =========================
   MOBILE
========================= */

@media(max-width:800px) {

  .navbar {
    padding: 0 20px;
  }

  .navbar nav {
    display: none;
  }

  .hero {
    min-height: auto;

    flex-direction: column;

    text-align: center;

    padding: 55px 20px;

    overflow: hidden;
  }

  .hero-content {
    width: 100%;

    position: relative;
    z-index: 20;
  }

  .hero-food {
    width: 100%;

    margin-top: 40px;

    position: relative;
    z-index: 2;
  }

  .hero-food img {
    width: 90%;
    max-width: 500px;
    height: 300px;

    object-fit: cover;

    border-radius: 45% 45% 45% 45%;
  }

  .hero-food .food-circle {
    width: 300px;
    height: 300px;
  }

  .customer-card {
    flex-direction: column;
    align-items: stretch;
  }

  .customer-inputs {
    flex-direction: column;
  }

  .customer-inputs input {
    width: 100%;
  }

  .category-row {
    gap: 20px;
  }

  .cart-bottom {
    flex-direction: column;
    align-items: stretch;
    gap: 20px;
  }

  .payment-buttons {
    flex-direction: column;
  }

  .credit-card {
    flex-direction: column;
    align-items: stretch;
    gap: 25px;
  }

  .credit-details {
    justify-content: space-between;
    gap: 10px;
  }

  .cart-item {
    flex-wrap: wrap;
  }
}


/* =========================
   EXTRA HERO PROTECTION
========================= */

/* Never allow hero image to cover hero text */

.hero-content,
.hero-content * {
  isolation: isolate;
}

.hero-food {
  isolation: isolate;
}

/* Keeps image strictly inside its own side */
.hero-food img {
  pointer-events: none;
}


/* =========================
   SMALL LAPTOP FIX
========================= */

@media (min-width: 801px) and (max-width: 1100px) {

  .hero {
    padding-left: 5%;
    padding-right: 5%;
  }

  .hero-content {
    width: 50%;
  }

  .hero-food {
    width: 45%;
  }

  .hero-food img {
    width: 100%;
    height: 380px;
  }

  .hero-food .food-circle {
    width: 350px;
    height: 350px;
  }
}
/* =========================================================
   THALASSERY FINAL UI
   GLASS NAVBAR + MOBILE 3-LINE MENU
========================================================= */

.navbar {
  position: sticky;
  top: 0;
  z-index: 1000;
  min-height: 72px;
  padding: 0 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;

  background: rgba(255,255,255,.82);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  border-bottom: 1px solid rgba(23,107,58,.12);
  box-shadow: 0 8px 30px rgba(11,67,36,.07);
}

.navbar nav {
  display: flex;
  align-items: center;
  gap: 26px;
}

.navbar nav a {
  color: #173321;
  text-decoration: none;
  font-size: 14px;
  font-weight: 700;
  transition: .2s ease;
}

.navbar nav a:hover {
  color: var(--green);
}

.cart-top {
  border: 0;
  background: var(--green);
  color: white;
  padding: 11px 17px;
  border-radius: 12px;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 7px 18px rgba(23,107,58,.2);
}

.cart-top:hover {
  background: var(--dark-green);
  transform: translateY(-1px);
}

/* 3 LINE BUTTON */

.nav-more-btn {
  display: none;
  width: 44px;
  height: 44px;
  border: 1px solid rgba(23,107,58,.15);
  border-radius: 13px;

  background: rgba(255,255,255,.75);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  color: var(--green);
  font-size: 23px;
  cursor: pointer;
}

/* GLASS MOBILE MENU */

.nav-more-menu {
  display: none;
  position: absolute;
  top: 64px;
  right: 18px;
  width: 205px;
  padding: 9px;

  background: rgba(255,255,255,.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  border: 1px solid rgba(23,107,58,.13);
  border-radius: 17px;

  box-shadow:
    0 18px 45px rgba(0,0,0,.14),
    0 3px 12px rgba(23,107,58,.08);

  z-index: 2000;
}

.nav-more-menu.active {
  display: block;
  animation: navGlassOpen .18s ease;
}

.nav-more-menu a {
  display: block;
  padding: 13px 14px;
  border-radius: 11px;

  color: #173321;
  text-decoration: none;
  font-size: 14px;
  font-weight: 700;
}

.nav-more-menu a:hover {
  background: var(--light-green);
  color: var(--green);
}

@keyframes navGlassOpen {
  from {
    opacity: 0;
    transform: translateY(-7px) scale(.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}


/* =========================================================
   DELIVERY DETAILS
========================================================= */

.delivery-user-info {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.delivery-field {
  margin: 12px 0;
}

.delivery-field label {
  display: block;
  margin-bottom: 7px;
  color: #173321;
  font-size: 13px;
  font-weight: 800;
}

.delivery-field label span {
  color: #888;
  font-weight: 500;
}

.delivery-field input,
.delivery-field textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 12px 13px;

  border: 1px solid #d6e2d9;
  border-radius: 11px;
  outline: none;

  background: white;
  color: #173321;
  font-family: inherit;
}

.delivery-field input:focus,
.delivery-field textarea:focus {
  border-color: var(--green);
  box-shadow: 0 0 0 3px rgba(23,107,58,.08);
}


/* =========================================================
   DELIVERY MAP
========================================================= */

.delivery-map-box {
  margin: 16px 0;
  padding: 15px;

  border: 1px solid rgba(23,107,58,.14);
  border-radius: 16px;

  background: rgba(248,251,248,.9);

  box-shadow: 0 8px 25px rgba(11,67,36,.05);
}

.delivery-map-title {
  margin-bottom: 12px;
}

.delivery-map-title span {
  display: block;
  color: #0b4324;
  font-size: 15px;
  font-weight: 800;
}

.delivery-map-title small {
  display: block;
  margin-top: 4px;
  color: #718176;
  font-size: 12px;
}

.delivery-map {
  width: 100%;
  height: 280px;

  overflow: hidden;

  border: 1px solid #d7e4da;
  border-radius: 13px;

  background: #e9f2eb;
}

.map-actions {
  display: flex;
  gap: 9px;
  margin-top: 10px;
  flex-wrap: wrap;
}

.map-location-btn,
.current-location-btn {
  border: 0;
  border-radius: 10px;
  padding: 10px 13px;

  font-family: inherit;
  font-size: 12px;
  font-weight: 800;

  cursor: pointer;
}

.map-location-btn {
  background: var(--green);
  color: white;
}

.map-location-btn:hover {
  background: var(--dark-green);
}

.current-location-btn {
  background: var(--light-green);
  color: var(--green);
}

.current-location-btn:hover {
  background: #dcebdd;
}

.selected-location {
  margin-top: 10px;
  padding: 9px 11px;

  border: 1px solid #e0ebe3;
  border-radius: 9px;

  background: white;
  color: #52685a;

  font-size: 12px;
  line-height: 1.5;
}

#deliveryMap .leaflet-control-attribution {
  font-size: 8px;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:800px) {

  .navbar {
    min-height: 64px;
    padding: 0 15px;
  }

  .navbar nav {
    display: none !important;
  }

  .nav-more-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cart-top {
    margin-left: auto;
    margin-right: 9px;
    padding: 10px 13px;
    font-size: 12px;
  }

  .nav-more-menu {
    top: 58px;
    right: 12px;
  }

  .delivery-user-info {
    grid-template-columns: 1fr;
  }

  .delivery-map {
    height: 240px;
  }

  .map-actions {
    flex-direction: column;
  }

  .map-location-btn,
  .current-location-btn {
    width: 100%;
  }

}


/* =========================================================
   SMALL LAPTOP
========================================================= */

@media(min-width:801px) and (max-width:1100px) {

  .navbar {
    padding-left: 4%;
    padding-right: 4%;
  }

  .navbar nav {
    gap: 16px;
  }

  .navbar nav a {
    font-size: 13px;
  }

}


/* =========================================================
   ADMIN ORDER BUTTONS
========================================================= */

#ordersTable td:last-child > div,
#recentOrders td:last-child > div {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
  flex-wrap: nowrap !important;
  white-space: nowrap !important;
}

#ordersTable td:last-child button,
#recentOrders td:last-child button {
  flex: 0 0 auto !important;
  white-space: nowrap !important;
}

#ordersTable td:last-child,
#recentOrders td:last-child {
  white-space: nowrap !important;
  min-width: 185px;
}



/* =========================================================
   CUSTOMER OTP
========================================================= */

.otp-box {
  margin-top: 14px;
  padding: 18px;
  border-radius: 16px;

  background: rgba(255,255,255,.82);
  border: 1px solid rgba(23,107,58,.13);

  box-shadow: 0 10px 30px rgba(11,67,36,.07);
}

.otp-title {
  color: var(--green);
  font-size: 16px;
  font-weight: 800;
}

.otp-subtitle {
  margin: 5px 0 12px;
  color: #718176;
  font-size: 12px;
}

.otp-box input {
  width: 100%;
  max-width: 260px;
  box-sizing: border-box;

  padding: 13px;
  border: 1px solid #cbd8ce;
  border-radius: 10px;

  outline: none;
  font-size: 18px;
  letter-spacing: 4px;
  text-align: center;
}

.otp-box input:focus {
  border-color: var(--green);
  box-shadow: 0 0 0 3px rgba(23,107,58,.08);
}

.otp-box .green-btn {
  margin-left: 7px;
}

.otp-resend {
  margin-left: 8px;
  border: 0;
  background: transparent;
  color: var(--green);
  font-weight: 800;
  cursor: pointer;
}

@media(max-width:800px) {

  .otp-box .green-btn,
  .otp-resend {
    margin: 9px 0 0;
    width: 100%;
  }

  .otp-box input {
    max-width: none;
  }

}




/* ============================================================
   THALASSERY FINAL AUTH + NAVIGATION UI
   ============================================================ */

.navbar {
  position: sticky;
  top: 0;
  z-index: 3000;
  min-height: 70px;
  padding: 0 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  background: rgba(255,255,255,.86);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(23,107,58,.12);
  box-shadow: 0 8px 30px rgba(11,67,36,.07);
}

.navbar .logo {
  white-space: nowrap;
  color: #176b3a;
  font-size: 19px;
  font-weight: 900;
}

.navbar .logo span {
  color: #c9973e;
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 24px;
}

.desktop-nav a {
  color: #173321;
  text-decoration: none;
  font-size: 14px;
  font-weight: 750;
}

.desktop-nav a:hover {
  color: #176b3a;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 9px;
}

.login-status {
  padding: 8px 11px;
  border-radius: 10px;
  background: #f1f5f2;
  color: #66756b;
  font-size: 12px;
  font-weight: 800;
  white-space: nowrap;
}

.login-status.logged-in {
  color: #176b3a;
  background: #e9f4ec;
}

.nav-more-btn {
  display: none;
  width: 43px;
  height: 43px;
  border: 1px solid rgba(23,107,58,.15);
  border-radius: 13px;
  background: rgba(255,255,255,.8);
  color: #176b3a;
  font-size: 23px;
  cursor: pointer;
}

.nav-more-menu {
  display: none;
  position: absolute;
  top: 64px;
  right: 15px;
  width: 220px;
  padding: 9px;
  background: rgba(255,255,255,.96);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(23,107,58,.13);
  border-radius: 17px;
  box-shadow: 0 18px 45px rgba(0,0,0,.14);
  z-index: 5000;
}

.nav-more-menu.active {
  display: block;
}

.nav-more-menu a {
  display: block;
  padding: 12px 13px;
  border-radius: 11px;
  color: #173321;
  text-decoration: none;
  font-size: 14px;
  font-weight: 750;
}

.nav-more-menu a:hover {
  background: #e9f2eb;
  color: #176b3a;
}

.mobile-menu-divider {
  height: 1px;
  background: #e3ebe5;
  margin: 6px 5px;
}


/* AUTH CARD */

.customer-auth-box {
  margin-top: 18px;
  padding: 18px;
  border: 1px solid rgba(23,107,58,.13);
  border-radius: 18px;
  background: rgba(255,255,255,.82);
  box-shadow: 0 10px 30px rgba(11,67,36,.06);
}

.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
  padding: 5px;
  margin-bottom: 18px;
  background: #eef4ef;
  border-radius: 12px;
}

.auth-tab {
  border: 0;
  padding: 11px;
  border-radius: 9px;
  background: transparent;
  color: #65746a;
  font-weight: 800;
  cursor: pointer;
}

.auth-tab.active {
  background: white;
  color: #176b3a;
  box-shadow: 0 3px 10px rgba(0,0,0,.06);
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.auth-heading {
  color: #173321;
  font-size: 17px;
  font-weight: 900;
}

.auth-subheading {
  margin: -4px 0 4px;
  color: #718176;
  font-size: 12px;
}

.auth-form input {
  width: 100%;
  box-sizing: border-box;
  padding: 13px;
  border: 1px solid #d2dfd5;
  border-radius: 11px;
  outline: none;
  background: white;
  color: #173321;
  font-family: inherit;
}

.auth-form input:focus {
  border-color: #176b3a;
  box-shadow: 0 0 0 3px rgba(23,107,58,.08);
}

.auth-main-btn {
  width: 100%;
  margin-top: 2px;
}

.otp-box {
  margin-top: 16px;
  padding: 17px;
  border-radius: 15px;
  background: rgba(248,251,248,.95);
  border: 1px solid rgba(23,107,58,.13);
}

.otp-title {
  color: #176b3a;
  font-size: 16px;
  font-weight: 900;
}

.otp-subtitle {
  margin: 5px 0 12px;
  color: #718176;
  font-size: 12px;
}

.otp-box input {
  width: 100%;
  max-width: 270px;
  box-sizing: border-box;
  padding: 13px;
  border: 1px solid #cbd8ce;
  border-radius: 10px;
  outline: none;
  font-size: 18px;
  letter-spacing: 4px;
  text-align: center;
}

.otp-resend {
  margin-top: 9px;
  border: 0;
  background: transparent;
  color: #176b3a;
  font-weight: 800;
  cursor: pointer;
}


@media (max-width: 800px) {

  .navbar {
    min-height: 64px;
    padding: 0 14px;
  }

  .navbar .logo {
    font-size: 16px;
  }

  .desktop-nav {
    display: none !important;
  }

  .nav-actions {
    margin-left: auto;
  }

  .login-status {
    display: none;
  }

  .nav-more-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cart-top {
    padding: 9px 12px;
    font-size: 12px;
  }

  .nav-more-menu {
    top: 60px;
  }

  .customer-auth-box {
    padding: 14px;
  }

  .otp-box input {
    max-width: none;
  }

}
