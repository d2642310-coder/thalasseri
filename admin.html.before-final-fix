            `).join("")

            :

            `
              <div class="empty">
                No orders found.
              </div>
            `
          }

        </div>


        <div class="detail-full"
             style="display:flex;gap:10px;">

          <button class="btn btn-gold"
                  onclick="closeCustomerModal();openCreditModal(${id})">

            Manage Credit

          </button>

        </div>

      </div>

    `;

  }catch(err){

    document.getElementById("customerDetails").innerHTML = `
      <div class="empty">
        Unable to load customer details.
      </div>
    `;

  }

}


