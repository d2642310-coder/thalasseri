/* =========================
   CREDIT
========================= */

function openCreditModal(id){

  const customer =
    currentCustomers.find(
      c=>Number(c.id)===Number(id)
    );

  if(!customer){

    showToast("Customer not found.");

    return;
  }


  const limit =
    Number(
      customer.credit_limit ??
      customer.limit ??
      500
    );

  const used =
    Number(
      customer.credit_used ??
      customer.used ??
      customer.balance ??
      0
    );


  document.getElementById("creditCustomerId").value =
    id;

  document.getElementById("creditLimit").value =
    limit;

  document.getElementById("paymentAmount").value =
    "";

  document.getElementById("paymentNote").value =
    "";


  document.getElementById("creditCustomerInfo").innerHTML = `

    <strong style="color:var(--green);font-size:18px;">

      ${escapeHtml(
        customer.name ||
        customer.customer_name ||
        "Customer"
      )}

    </strong>

    <div class="customer-phone">
      ${escapeHtml(customer.phone || "-")}
    </div>

    <div style="
      margin-top:10px;
      display:flex;
      justify-content:space-between;
      gap:10px;
    ">

      <span>
        Used:
        <strong>
          ${formatAED(used)}
        </strong>
      </span>

      <span>
        Limit:
        <strong>
          ${formatAED(limit)}
        </strong>
      </span>

    </div>

  `;


  openModal("creditModal");

}


function closeCreditModal(){

  closeModal("creditModal");

}


async function saveCreditLimit(){

  const id =
    document.getElementById("creditCustomerId").value;

  const limit =
    Number(
      document.getElementById("creditLimit").value
    );


  if(!id || limit < 0){

    showToast("Enter a valid credit limit.");

    return;
  }


  try{

    await api(
      `/api/admin/customers/${id}/credit`,
      {
        method:"PUT",
        body:JSON.stringify({
          credit_limit:limit
        })
      }
    );

    showToast("Credit limit updated.");

    closeCreditModal();

    loadCustomers();

  }catch(err){

    showToast(err.message);

  }

}


async function recordPayment(){

  const id =
    document.getElementById("creditCustomerId").value;

  const amount =
    Number(
      document.getElementById("paymentAmount").value
    );

  const note =
    document.getElementById("paymentNote").value.trim();


  if(!id || amount <= 0){

    showToast("Enter a valid payment amount.");

    return;
  }


  try{

    await api(
      `/api/admin/customers/${id}/payment`,
      {
        method:"POST",
        body:JSON.stringify({
          amount,
          note
        })
      }
    );

    showToast("Payment recorded.");

    closeCreditModal();

    loadCustomers();

  }catch(err){

    showToast(err.message);

  }

}


/* =========================
   MODALS
========================= */

function openModal(id){

  document
    .getElementById(id)
    .classList.add("show");

}


function closeModal(id){

  document
    .getElementById(id)
    .classList.remove("show");

}


document
  .querySelectorAll(".modal")
  .forEach(modal=>{

    modal.addEventListener("click",function(e){

      if(e.target === modal){

        modal.classList.remove("show");

      }

    });

  });


/* =========================
   HELPERS
========================= */

function formatAED(value){

  const number =
    Number(value || 0);

  return `${number.toFixed(2)} AED`;

}


function formatDate(value){

  if(!value){
    return "";
  }

  try{

    return new Date(value)
      .toLocaleString();

  }catch(e){

    return String(value);

  }

}


function escapeHtml(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


function escapeAttr(value){

  return escapeHtml(value);

}


function showToast(message){

  const toast =
    document.getElementById("toast");

  toast.textContent =
    message;

  toast.classList.add("show");

  setTimeout(()=>{

    toast.classList.remove("show");

  },2500);

}


