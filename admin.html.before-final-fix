        </div>

        ${
          items.length
          ?
          items.map(item=>`

            <div class="order-item">

              <div>

                <strong>
                  ${escapeHtml(
                    item.name ||
                    item.food_name ||
                    "Food"
                  )}
                </strong>

                <div class="customer-phone">
                  Qty: ${item.qty ?? item.quantity ?? 1}
                </div>

              </div>

              <strong>
                ${formatAED(
                  (
                    Number(item.price || 0) *
                    Number(
                      item.qty ??
                      item.quantity ??
                      1
                    )
                  )
                )}
              </strong>

            </div>

          `).join("")
          :
          `<div class="empty">No item details available.</div>`
        }

      </div>


      <div class="detail-box detail-full">

        <div class="detail-label">
          TOTAL
        </div>

        <div class="detail-value"
             style="font-size:25px;color:var(--green);">

          ${formatAED(order.total)}

        </div>

      </div>

    </div>
  `;

  openModal("orderModal");

}


function normalizeItems(order){

  if(Array.isArray(order.items)){
    return order.items;
  }

  if(Array.isArray(order.order_items)){
    return order.order_items;
  }

  return [];

}


function getOrderItemsText(order){

  const items =
    normalizeItems(order);

  if(!items.length){

    return (
      order.items_summary ||
      order.item_names ||
      "-"
    );

  }

  return items.map(item=>{

    const qty =
      item.qty ??
      item.quantity ??
      1;

    return `${item.name || item.food_name} × ${qty}`;

  }).join(", ");

}


function closeOrderModal(){

  closeModal("orderModal");

}


/* =========================
   MENU
========================= */

async function loadMenu(){

  try{

    const data =
      await api("/api/menu");

    currentMenu =
      Array.isArray(data)
        ? data
        : (data.menu || data.items || []);

    renderMenu();

  }catch(err){

    showToast(err.message);

  }

}


function renderMenu(){

  const grid =
    document.getElementById("menuGrid");

  if(!currentMenu.length){

    grid.innerHTML = `
      <div class="card"
           style="grid-column:1/-1;">
        <div class="empty">
          No menu items.
        </div>
      </div>
    `;

    return;
  }

  grid.innerHTML =
    currentMenu.map(item=>{

      const image =
        item.image ||
        item.image_url ||
        item.emoji ||
        "🍛";

      const isUrl =
        /^https?:\/\//i.test(image);

      return `

        <div class="menu-card">

          <div class="menu-img">

            ${
              isUrl
              ?
              `<img src="${escapeAttr(image)}"
                    alt="${escapeAttr(item.name || "")}"
                    onerror="this.style.display='none'">`
              :
              escapeHtml(image)
            }

          </div>


          <div class="menu-body">

            <h3>
              ${escapeHtml(item.name || "Food")}
            </h3>

            <div class="menu-description">
              ${escapeHtml(
                item.description || ""
              )}
            </div>


            <div class="menu-bottom">

              <div class="menu-price">
                ${formatAED(item.price)}
              </div>

              ${
                Number(item.available)
                ?
                `<span class="badge">Available</span>`
                :
                `<span class="badge badge-danger">Sold Out</span>`
              }

            </div>


            <div class="menu-actions">

              <button class="btn btn-light"
                      onclick="editMenu(${item.id})">
                Edit
              </button>

              <button class="btn btn-danger"
                      onclick="deleteMenu(${item.id})">
                Delete
              </button>

            </div>

          </div>

        </div>

      `;

    }).join("");

}


function openMenuModal(item=null){

  document.getElementById("menuModalTitle").textContent =
    item ? "Edit Food" : "Add Food";

  document.getElementById("menuId").value =
    item?.id || "";

  document.getElementById("menuName").value =
    item?.name || "";

  document.getElementById("menuDescription").value =
    item?.description || "";

  document.getElementById("menuCategory").value =
    item?.category || "Biriyani";

  document.getElementById("menuPrice").value =
    item?.price || "";

  document.getElementById("menuImage").value =
    item?.image ||
    item?.image_url ||
    item?.emoji ||
    "";

  document.getElementById("menuAvailable").value =
    Number(item?.available ?? 1) ? "1" : "0";

  openModal("menuModal");

}


function closeMenuModal(){

  closeModal("menuModal");

}


function editMenu(id){

  const item =
    currentMenu.find(
      item=>Number(item.id)===Number(id)
    );

  if(item){
    openMenuModal(item);
  }

}


async function saveMenu(){

  const id =
    document.getElementById("menuId").value;

  const payload = {

    name:
      document.getElementById("menuName").value.trim(),

    description:
      document.getElementById("menuDescription").value.trim(),

    category:
      document.getElementById("menuCategory").value,

    price:
      Number(
        document.getElementById("menuPrice").value
      ),

    image:
      document.getElementById("menuImage").value.trim(),

    available:
      Number(
        document.getElementById("menuAvailable").value
      )

  };


  if(!payload.name){

    showToast("Enter food name.");

    return;
  }

  if(!payload.price){

    showToast("Enter food price.");

    return;
  }


  try{

    if(id){

      await api(
        `/api/admin/menu/${id}`,
        {
          method:"PUT",
          body:JSON.stringify(payload)
        }
      );

      showToast("Food updated.");

    }else{

      await api(
        "/api/admin/menu",
        {
          method:"POST",
          body:JSON.stringify(payload)
        }
      );

      showToast("Food added.");

    }

    closeMenuModal();

    loadMenu();

  }catch(err){

    showToast(err.message);

  }

}


async function deleteMenu(id){

  if(!confirm(
    "Delete this food item?"
  )){
    return;
  }

  try{

    await api(
      `/api/admin/menu/${id}`,
      {
        method:"DELETE"
      }
    );

    showToast("Food deleted.");

    loadMenu();

  }catch(err){

    showToast(err.message);

  }

}


