              details.name ||
              details.customer_name ||
              "Customer"
            )}
          </div>
        </div>


        <div class="detail-box">
          <div class="detail-label">
            Phone
          </div>

          <div class="detail-value">
            ${escapeHtml(
              details.phone || "-"
            )}
          </div>
        </div>


        <div class="detail-box">
          <div class="detail-label">
            Credit Limit
          </div>

          <div class="detail-value">
            ${formatAED(limit)}
          </div>
        </div>


        <div class="detail-box">
          <div class="detail-label">
            Credit Used
          </div>

          <div class="detail-value">
            ${formatAED(used)}
          </div>
        </div>


        <div class="detail-box">

          <div class="detail-label">
            Available Credit
          </div>

          <div class="detail-value"
               style="color:var(--green);">

            ${formatAED(available)}

          </div>

        </div>


        <div class="detail-box">

          <div class="detail-label">
            Customer ID
          </div>

          <div class="detail-value">
            #${id}
          </div>

        </div>


        <div class="detail-box detail-full">

          <div class="detail-label">
            ORDER HISTORY
          </div>


          ${
            orders.length
            ?

            orders.map(order=>`

              <div class="history-item">

                <div style="
                  display:flex;
                  justify-content:space-between;
                  gap:10px;
                  align-items:center;
                ">

                  <strong>
                    Order #${order.id}
                  </strong>

                  <span class="badge">
                    ${escapeHtml(
                      order.status ||
                      "Pending"
                    )}
                  </span>

                </div>


                <div style="
                  margin-top:7px;
                  display:flex;
                  justify-content:space-between;
                ">

                  <span>
                    ${escapeHtml(
                      getOrderItemsText(order)
                    )}
                  </span>

                  <strong>
                    ${formatAED(order.total)}
                  </strong>

                </div>


                <div class="customer-phone">
                  ${formatDate(order.created_at)}
                </div>

