<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>THALASSERY — Owner Dashboard</title>

<style>

:root{
  --green:#176b3a;
  --dark-green:#0b4324;
  --light-green:#e9f2eb;
  --cream:#f8f6ef;
  --gold:#c9973e;
  --white:#ffffff;
  --text:#1e2a22;
  --muted:#718078;
  --border:#e3e9e4;
  --danger:#c0392b;
  --shadow:0 12px 35px rgba(11,67,36,.08);
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Inter,Arial,sans-serif;
  background:var(--cream);
  color:var(--text);
}

/* =========================
   LOGIN
========================= */

.login-page{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  background:
    radial-gradient(circle at top right,#e9f2eb,transparent 40%),
    var(--cream);
}

.login-card{
  width:100%;
  max-width:430px;
  background:white;
  padding:42px;
  border-radius:25px;
  box-shadow:var(--shadow);
  border:1px solid var(--border);
}

.logo{
  text-align:center;
  margin-bottom:30px;
}

.logo h1{
  color:var(--green);
  font-size:32px;
  letter-spacing:2px;
}

.logo span{
  display:block;
  color:var(--gold);
  font-size:12px;
  letter-spacing:5px;
  margin-top:4px;
}

.login-title{
  font-size:22px;
  margin-bottom:8px;
}

.login-sub{
  color:var(--muted);
  margin-bottom:25px;
}

input,select,textarea{
  width:100%;
  padding:13px 15px;
  border:1px solid var(--border);
  border-radius:12px;
  outline:none;
  background:white;
  font-size:14px;
}

input:focus,
select:focus,
textarea:focus{
  border-color:var(--green);
  box-shadow:0 0 0 3px rgba(23,107,58,.08);
}

.form-group{
  margin-bottom:17px;
}

.form-group label{
  display:block;
  font-size:13px;
  font-weight:700;
  margin-bottom:7px;
}

.btn{
  border:none;
  border-radius:12px;
  padding:12px 18px;
  cursor:pointer;
  font-weight:700;
  transition:.2s;
}

.btn:hover{
  transform:translateY(-1px);
}

.btn-primary{
  background:var(--green);
  color:white;
}

.btn-primary:hover{
  background:var(--dark-green);
}

.btn-light{
  background:var(--light-green);
  color:var(--green);
}

.btn-danger{
  background:#fdecea;
  color:var(--danger);
}

.btn-gold{
  background:var(--gold);
  color:white;
}

.full{
  width:100%;
}

.error{
  color:var(--danger);
  font-size:13px;
  margin-top:12px;
}

/* =========================
   APP
========================= */

.app{
  display:none;
  min-height:100vh;
}

/* TOP NAV */

.topbar{
  height:74px;
  background:white;
  border-bottom:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 30px;
  position:sticky;
  top:0;
  z-index:50;
}

.brand{
  font-weight:900;
  font-size:22px;
  color:var(--green);
  letter-spacing:1px;
}

.brand span{
  color:var(--gold);
  font-size:10px;
  letter-spacing:3px;
  display:block;
}

.owner-area{
  display:flex;
  align-items:center;
  gap:12px;
}

.owner-badge{
  background:var(--light-green);
  color:var(--green);
  padding:8px 13px;
  border-radius:30px;
  font-size:13px;
  font-weight:700;
}

.mobile-menu{
  display:none;
}

/* LAYOUT */

.layout{
  display:flex;
}

.sidebar{
  width:240px;
  min-height:calc(100vh - 74px);
  background:white;
  border-right:1px solid var(--border);
  padding:22px 15px;
  position:sticky;
  top:74px;
  height:calc(100vh - 74px);
}

.side-title{
  font-size:11px;
  color:var(--muted);
  letter-spacing:2px;
  margin:10px 12px;
}

.side-btn{
  width:100%;
  border:none;
  background:transparent;
  text-align:left;
  padding:13px 14px;
  border-radius:12px;
  margin-bottom:5px;
  cursor:pointer;
  color:#536158;
  font-weight:700;
}

.side-btn:hover{
  background:var(--light-green);
  color:var(--green);
}

.side-btn.active{
  background:var(--green);
  color:white;
}

.main{
  flex:1;
  padding:30px;
  max-width:1500px;
}

/* =========================
   SECTION
========================= */

.section{
  display:none;
}

.section.active{
  display:block;
}

.section-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:22px;
  gap:15px;
}

.section-head h2{
  font-size:27px;
}

.section-head p{
  color:var(--muted);
  font-size:14px;
  margin-top:4px;
}

/* =========================
   DASHBOARD
========================= */

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
  margin-bottom:25px;
}

.stat{
  background:white;
  border:1px solid var(--border);
  border-radius:18px;
  padding:22px;
  box-shadow:var(--shadow);
}

.stat-label{
  color:var(--muted);
  font-size:12px;
  font-weight:700;
  letter-spacing:.5px;
}

.stat-value{
  font-size:30px;
  font-weight:900;
  color:var(--green);
  margin-top:9px;
}

.card{
  background:white;
  border:1px solid var(--border);
  border-radius:18px;
  box-shadow:var(--shadow);
  overflow:hidden;
}

.card-head{
  padding:18px 20px;
  border-bottom:1px solid var(--border);
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.card-head h3{
  font-size:17px;
}

/* =========================
   TABLE
========================= */

.table-wrap{
  overflow-x:auto;
}

table{
  width:100%;
  border-collapse:collapse;
}

th{
  text-align:left;
  font-size:11px;
  color:var(--muted);
  padding:14px 18px;
  border-bottom:1px solid var(--border);
  white-space:nowrap;
}

td{
  padding:15px 18px;
  border-bottom:1px solid #edf1ee;
  font-size:13px;
  vertical-align:middle;
}

tr:last-child td{
  border-bottom:none;
}

.customer-name{
  font-weight:800;
}

.customer-phone{
  color:var(--muted);
  font-size:12px;
  margin-top:3px;
}

.money{
  font-weight:800;
  color:var(--green);
}

.badge{
  display:inline-flex;
  align-items:center;
  padding:6px 10px;
  border-radius:30px;
  font-size:11px;
  font-weight:800;
  background:var(--light-green);
  color:var(--green);
}

.badge-danger{
  background:#fdecea;
  color:var(--danger);
}

.badge-gold{
  background:#f8efd9;
  color:#936a18;
}

/* =========================
   MENU
========================= */

.menu-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.menu-card{
  background:white;
  border:1px solid var(--border);
  border-radius:18px;
  overflow:hidden;
  box-shadow:var(--shadow);
}

.menu-img{
  height:180px;
  background:var(--light-green);
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  font-size:55px;
}

.menu-img img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.menu-body{
  padding:18px;
}

.menu-body h3{
  font-size:18px;
  margin-bottom:6px;
}

.menu-description{
  color:var(--muted);
  font-size:12px;
  min-height:35px;
}

.menu-bottom{
  margin-top:15px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.menu-price{
  color:var(--green);
  font-size:20px;
  font-weight:900;
}

.menu-actions{
  display:flex;
  gap:7px;
  margin-top:15px;
}

/* =========================
   MODAL
========================= */

.modal{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.45);
  z-index:100;
  align-items:center;
  justify-content:center;
  padding:20px;
}

.modal.show{
  display:flex;
}

.modal-box{
  width:100%;
  max-width:620px;
  max-height:90vh;
  overflow-y:auto;
  background:white;
  border-radius:22px;
  box-shadow:0 30px 80px rgba(0,0,0,.2);
}

.modal-head{
  padding:20px 23px;
  border-bottom:1px solid var(--border);
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  background:white;
  z-index:2;
}

.modal-head h3{
  color:var(--green);
}

.close{
  border:none;
  background:var(--light-green);
  width:34px;
  height:34px;
  border-radius:50%;
  cursor:pointer;
  color:var(--green);
  font-size:18px;
}

.modal-body{
  padding:23px;
}

/* =========================
   DETAIL
========================= */

.detail-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:13px;
}

.detail-box{
  background:#f7faf7;
  border:1px solid var(--border);
  border-radius:13px;
  padding:14px;
}

.detail-label{
  color:var(--muted);
  font-size:11px;
  font-weight:700;
  text-transform:uppercase;
  margin-bottom:5px;
}

.detail-value{
  font-weight:800;
  font-size:15px;
}

.detail-full{
  grid-column:1/-1;
}

.order-item{
  display:flex;
  justify-content:space-between;
  padding:13px 0;
  border-bottom:1px solid var(--border);
}

.order-item:last-child{
  border-bottom:none;
}

.history-item{
  padding:13px;
  background:#f7faf7;
  border-radius:12px;
  margin-bottom:9px;
}

.history-item strong{
  color:var(--green);
}

.empty{
  text-align:center;
  padding:40px 20px;
  color:var(--muted);
}

/* =========================
   TOAST
========================= */

.toast{
  position:fixed;
  right:25px;
  bottom:25px;
  background:var(--dark-green);
  color:white;
  padding:14px 18px;
  border-radius:12px;
  display:none;
  z-index:200;
  box-shadow:var(--shadow);
}

.toast.show{
  display:block;
}

/* =========================
   MOBILE
========================= */

@media(max-width:1000px){

  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .menu-grid{
    grid-template-columns:repeat(2,1fr);
  }

}

@media(max-width:750px){

  .topbar{
    padding:0 16px;
  }

  .mobile-menu{
    display:block;
    border:none;
    background:var(--light-green);
    color:var(--green);
    padding:9px 12px;
    border-radius:10px;
    font-weight:900;
  }

  .owner-badge{
    display:none;
  }

  .sidebar{
    position:fixed;
    left:-260px;
    top:74px;
    z-index:90;
    transition:.25s;
    box-shadow:10px 0 30px rgba(0,0,0,.1);
  }

  .sidebar.open{
    left:0;
  }

  .main{
    padding:20px 15px;
    width:100%;
  }

  .stats{
    grid-template-columns:1fr 1fr;
    gap:10px;
  }

  .stat{
    padding:16px;
  }

  .stat-value{
    font-size:23px;
  }

  .menu-grid{
    grid-template-columns:1fr;
  }

  .section-head{
    align-items:flex-start;
  }

  .section-head h2{
    font-size:23px;
  }

  .detail-grid{
    grid-template-columns:1fr;
  }

  .detail-full{
    grid-column:auto;
  }

}

</style>

<style>
.order-action-buttons {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
  flex-wrap: nowrap !important;
  white-space: nowrap !important;
}

.order-action-buttons .btn {
  margin: 0 !important;
  min-width: 72px !important;
  height: 36px !important;
  padding: 0 12px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
}

.order-action-buttons .location-btn {
  border: 1px solid #d7e4da !important;
  border-radius: 10px !important;
  background: #f8fbf8 !important;
  color: #176b3a !important;
  cursor: pointer !important;
}

.order-action-buttons .location-btn:hover {
  background: #e9f2eb !important;
  border-color: #176b3a !important;
}

@media (max-width: 700px) {
  .order-action-buttons {
    justify-content: flex-start !important;
  }
}
</style>

</head>

<body>

<!-- =========================
     LOGIN
========================= -->

<div id="loginPage" class="login-page">

  <div class="login-card">

    <div class="logo">
      <h1>THALASSERY</h1>
      <span>FOOD • OWNER PANEL</span>
    </div>

    <div class="login-title">Owner Login</div>
    <div class="login-sub">
      Manage your food business from one place.
    </div>

    <div class="form-group">
      <label>USERNAME</label>
      <input id="username" type="text" placeholder="Enter username">
    </div>

    <div class="form-group">
      <label>PASSWORD</label>
      <input id="password" type="password" placeholder="Enter password">
    </div>

    <button class="btn btn-primary full" onclick="login()">
      Login
    </button>

    <div id="loginError" class="error"></div>

  </div>

</div>


<!-- =========================
     APP
========================= -->

<div id="app" class="app">

  <header class="topbar">

    <div style="display:flex;align-items:center;gap:12px;">

      <button class="mobile-menu" onclick="toggleSidebar()">
        ☰
      </button>

      <div class="brand">
        THALASSERY
        <span>FOOD OWNER PANEL</span>
      </div>

    </div>

    <div class="owner-area">

      <div class="owner-badge">
        👤 Owner
      </div>

      <button class="btn btn-light" onclick="logout()">
        Logout
      </button>

    </div>

  </header>


  <div class="layout">

    <!-- SIDEBAR -->

    <aside id="sidebar" class="sidebar">

      <div class="side-title">
        MANAGEMENT
      </div>

      <button class="side-btn active"
              data-section="overview"
              onclick="showSection('overview')">
        📊 Overview
      </button>

      <button class="side-btn"
              data-section="orders"
              onclick="showSection('orders')">
        🧾 Orders
      </button>

      <button class="side-btn"
              data-section="menu"
              onclick="showSection('menu')">
        🍗 Menu
      </button>

      <button class="side-btn"
              data-section="customers"
              onclick="showSection('customers')">
        👥 Customers
      </button>

      <button class="side-btn"
              data-section="credit"
              onclick="showSection('credit')">
        💳 Credit
      </button>

    </aside>


    <!-- MAIN -->

    <main class="main">


      <!-- =========================
           OVERVIEW
      ========================= -->

      <section id="overview" class="section active">

        <div class="section-head">

          <div>
            <h2>Dashboard</h2>
            <p>Welcome back, Owner.</p>
          </div>

          <button class="btn btn-light"
                  onclick="loadDashboard()">
            ↻ Refresh
          </button>

        </div>


        <div class="stats">

          <div class="stat">
            <div class="stat-label">TODAY'S ORDERS</div>
            <div id="statOrders" class="stat-value">0</div>
          </div>

          <div class="stat">
            <div class="stat-label">TODAY'S SALES</div>
            <div id="statSales" class="stat-value">0 AED</div>
          </div>

          <div class="stat">
            <div class="stat-label">CUSTOMERS</div>
            <div id="statCustomers" class="stat-value">0</div>
          </div>

          <div class="stat">
            <div class="stat-label">OUTSTANDING CREDIT</div>
            <div id="statCredit" class="stat-value">0 AED</div>
          </div>

        </div>


        <div class="card">

          <div class="card-head">

            <h3>Recent Orders</h3>

            <button class="btn btn-light"
                    onclick="showSection('orders')">
              View All
            </button>

          </div>

          <div class="table-wrap">

            <table>

              <thead>
                <tr>
                  <th>ORDER</th>
                  <th>CUSTOMER</th>
                  <th>TOTAL</th>
                  <th>PAYMENT</th>
                  <th>STATUS</th>
                  <th>ACTION</th>
                </tr>
              </thead>

              <tbody id="recentOrders"></tbody>

            </table>

          </div>

        </div>

      </section>


      <!-- =========================
           ORDERS
      ========================= -->

      <section id="orders" class="section">

        <div class="section-head">

          <div>
            <h2>Orders</h2>
            <p>Manage incoming customer orders.</p>
          </div>

          <button class="btn btn-light"
                  onclick="loadOrders()">
            ↻ Refresh
          </button>

        </div>


        <div class="card">

          <div class="table-wrap">

            <table>

              <thead>

                <tr>
                  <th>ORDER</th>
                  <th>CUSTOMER</th>
                  <th>ITEMS</th>
                  <th>TOTAL</th>
                  <th>PAYMENT</th>
                  <th>STATUS</th>
                  <th>ACTION</th>
                </tr>

              </thead>

              <tbody id="ordersTable"></tbody>

            </table>

          </div>

        </div>

      </section>


      <!-- =========================
           MENU
      ========================= -->

      <section id="menu" class="section">

        <div class="section-head">

          <div>
            <h2>Menu</h2>
            <p>Add, edit and manage your food items.</p>
          </div>

          <button class="btn btn-primary"
                  onclick="openMenuModal()">
            + Add Food
          </button>

        </div>


        <div id="menuGrid" class="menu-grid"></div>

      </section>


      <!-- =========================
           CUSTOMERS
      ========================= -->

      <section id="customers" class="section">

        <div class="section-head">

          <div>
            <h2>Customers</h2>
            <p>Customer details, orders and credit information.</p>
          </div>

          <button class="btn btn-light"
                  onclick="loadCustomers()">
            ↻ Refresh
          </button>

        </div>


        <div class="card">

          <div class="table-wrap">

            <table>

              <thead>

                <tr>
                  <th>CUSTOMER</th>
                  <th>PHONE</th>
                  <th>LIMIT</th>
                  <th>USED</th>
                  <th>AVAILABLE</th>
                  <th>ACTION</th>
                </tr>

              </thead>

              <tbody id="customersTable"></tbody>

            </table>

          </div>

        </div>

      </section>


      <!-- =========================
           CREDIT
      ========================= -->

      <section id="credit" class="section">

        <div class="section-head">

          <div>
            <h2>Credit Management</h2>
            <p>Manage customer limits and payments.</p>
          </div>

          <button class="btn btn-light"
                  onclick="loadCustomers()">
            ↻ Refresh
          </button>

        </div>


        <div class="card">

          <div class="table-wrap">

            <table>

              <thead>

                <tr>
                  <th>CUSTOMER</th>
                  <th>PHONE</th>
                  <th>CREDIT LIMIT</th>
                  <th>USED</th>
                  <th>AVAILABLE</th>
                  <th>ACTION</th>
                </tr>

              </thead>

              <tbody id="creditTable"></tbody>

            </table>

          </div>

        </div>

      </section>

    </main>

  </div>

</div>


<!-- =========================
     MENU MODAL
========================= -->

<div id="menuModal" class="modal">

  <div class="modal-box">

    <div class="modal-head">

      <h3 id="menuModalTitle">
        Add Food
      </h3>

      <button class="close"
              onclick="closeMenuModal()">
        ×
      </button>

    </div>


    <div class="modal-body">

      <input type="hidden" id="menuId">

      <div class="form-group">
        <label>FOOD NAME</label>
        <input id="menuName"
               placeholder="Chicken Biriyani">
      </div>

      <div class="form-group">
        <label>DESCRIPTION</label>
        <textarea id="menuDescription"
                  rows="3"
                  placeholder="Food description"></textarea>
      </div>

      <div class="detail-grid">

        <div class="form-group">
          <label>CATEGORY</label>

          <select id="menuCategory">

            <option value="Biriyani">Biriyani</option>
            <option value="Chicken">Chicken</option>
            <option value="Meals">Meals</option>
            <option value="Rolls">Rolls</option>
            <option value="Drinks">Drinks</option>

          </select>

        </div>


        <div class="form-group">

          <label>PRICE (AED)</label>

          <input id="menuPrice"
                 type="number"
                 step="0.01"
                 placeholder="12">

        </div>

      </div>


      <div class="form-group">

        <label>IMAGE / EMOJI</label>

        <input id="menuImage"
               placeholder="🍗 or image URL">

      </div>


      <div class="form-group">

        <label>AVAILABILITY</label>

        <select id="menuAvailable">

          <option value="1">Available</option>
          <option value="0">Sold Out</option>

        </select>

      </div>


      <button class="btn btn-primary full"
              onclick="saveMenu()">

        Save Food

      </button>

    </div>

  </div>

</div>


<!-- =========================
     CUSTOMER DETAILS MODAL
========================= -->

<div id="customerModal" class="modal">

  <div class="modal-box">

    <div class="modal-head">

      <h3>Customer Details</h3>

      <button class="close"
              onclick="closeCustomerModal()">
        ×
      </button>

    </div>

