/* =========================
   CUSTOMER DETAILS
========================= */

async function viewCustomer(id){

  const customer =
    currentCustomers.find(
      c=>Number(c.id)===Number(id)
    );

  if(!customer){

    showToast("Customer not found.");

    return;
  }

  openModal("customerModal");

  document.getElementById("customerDetails").innerHTML = `
    <div class="empty">
      Loading customer details...
    </div>
  `;


  try{

    let details = customer;

    try{

      const result =
        await api(`/api/customer/${id}`);

      if(result){
        details =
          result.customer ||
          result;
      }

    }catch(e){}


    let orders = [];

