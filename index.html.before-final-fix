<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>THALASSERY</title>

  <link rel="stylesheet" href="/style.css">
</head>

<body>

  <!-- NAVBAR -->
  <header class="navbar">

    <div class="logo">
      THALASSERY
      <span>FOOD</span>
    </div>

    <nav>
      <a href="#home">Home</a>
      <a href="#categories">Categories</a>
      <a href="#menu">Menu</a>
      <a href="#orders">Orders</a>
    </nav>

    <button class="cart-top" onclick="scrollToCart()">
      🛒 Cart
      <span id="cartCount">0</span>
    </button>

  </header>


  <!-- HERO -->
  <section class="hero" id="home">

    <div class="hero-content">

      <div class="small-title">
        AUTHENTIC KERALA FLAVOUR
      </div>

      <h1>
        Taste of<br>
        <span>Thalassery</span>
      </h1>

      <p>
        Traditional Kerala flavours,
        freshly prepared for you.
      </p>

      <button
        class="main-btn"
        onclick="scrollToMenu()"
      >
        Explore Menu →
      </button>

    </div>

    <div class="hero-food">

      <div class="food-circle"></div>

      <img
        src="https://cdn.phototourl.com/free/2026-09-12-c506127c-6326-49c7-ac1d-e630733667af.jpg"
        alt="Thalassery food"
      >

    </div>

  </section>


  <!-- CUSTOMER -->
  <section class="customer-section">

    <div class="customer-card">

      <div>
        <span class="section-mini">ORDERING AS</span>
        <h2>Customer</h2>
      </div>

      <div class="customer-inputs">

        <input
          id="customerName"
          type="text"
          placeholder="Your name"
        >

        <input
          id="customerPhone"
          type="tel"
          placeholder="Phone number"
        >

        <button
          class="green-btn"
          onclick="saveCustomer()"
        >
          Continue
        </button>

      </div>

    </div>

  </section>


  <!-- CATEGORIES -->
  <section class="categories-section" id="categories">

    <div class="section-heading">

      <span>EXPLORE</span>

      <h2>Our Categories</h2>

    </div>

    <div class="category-row">

      <div class="category">
        <div class="category-icon">🍛</div>
        <h3>Biriyani</h3>
        <p>Authentic taste</p>
      </div>

      <div class="category">
        <div class="category-icon">🍗</div>
        <h3>Chicken</h3>
        <p>Fresh & tasty</p>
      </div>

      <div class="category">
        <div class="category-icon">🥘</div>
        <h3>Meals</h3>
        <p>Kerala style</p>
      </div>

      <div class="category">
        <div class="category-icon">🌯</div>
        <h3>Rolls</h3>
        <p>Quick bites</p>
      </div>

      <div class="category">
        <div class="category-icon">🥤</div>
        <h3>Drinks</h3>
        <p>Fresh drinks</p>
      </div>

    </div>

  </section>


  <!-- MENU -->
  <section class="menu-section" id="menu">

    <div class="section-heading">

      <span>FRESH FROM KITCHEN</span>

      <h2>Popular Menu</h2>

      <p>
        Delicious food made with
        authentic Kerala flavours.
      </p>

    </div>

    <div
      id="menuGrid"
      class="menu-grid"
    >
      <div class="loading">
        Loading menu...
      </div>
    </div>

  </section>


  <!-- CART -->
  <section
    class="cart-section"
    id="cart"
  >

    <div class="cart-card">

      <div class="cart-header">

        <div>
          <span>YOUR ORDER</span>
          <h2>Shopping Cart</h2>
        </div>

        <div
          class="cart-total-top"
          id="cartTotal"
        >
          AED 0.00
        </div>

      </div>


      <div
        id="cartItems"
        class="cart-items"
      >

        <div class="empty-cart">
          Your cart is empty
        </div>

      </div>


      <div class="cart-bottom">

        <div>

          <small>TOTAL</small>

          <strong id="cartTotalBottom">
            AED 0.00
          </strong>

        </div>

        <div class="payment-buttons">

          <button
            class="pay-btn"
            onclick="placeOrder('pay')"
          >
            💵 Pay Now
          </button>

          <button
            class="credit-btn"
            onclick="placeOrder('credit')"
          >
            💳 Add to Credit
          </button>

        </div>

      </div>

    </div>

  </section>


  <!-- CREDIT -->
  <section class="credit-section">

    <div class="credit-card">

      <div>
        <span>MY ACCOUNT</span>
        <h2>Credit Balance</h2>
      </div>

      <div class="credit-details">

        <div>
          <small>LIMIT</small>
          <strong id="creditLimit">
            AED 0.00
          </strong>
        </div>

        <div>
          <small>USED</small>
          <strong id="creditUsed">
            AED 0.00
          </strong>
        </div>

        <div class="available">
          <small>AVAILABLE</small>
          <strong id="creditAvailable">
            AED 0.00
          </strong>
        </div>

      </div>

    </div>

  </section>


  <!-- ORDERS -->
  <section
    class="orders-section"
    id="orders"
  >

    <div class="section-heading">

      <span>YOUR HISTORY</span>

      <h2>My Orders</h2>

    </div>

    <div id="ordersList">

      <div class="empty-orders">
        Login as customer to see your orders.
      </div>

    </div>

  </section>


  <!-- FOOTER -->
  <footer>

    <div class="footer-logo">
      THALASSERY
    </div>

    <p>
      Authentic Kerala Food
    </p>

    <div class="footer-line"></div>

    <small>
      © 2026 THALASSERY. All rights reserved.
    </small>

  </footer>


  <div id="message"></div>


  <script src="/script.js"></script>

</body>
</html>