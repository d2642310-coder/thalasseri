let cart = [];
let customerId =
  localStorage.getItem("thalasseri_customer_id");


// ============================
// MESSAGE
// ============================

function showMessage(text) {

  const box =
    document.getElementById("message");

  box.innerText = text;
  box.style.display = "block";

  setTimeout(() => {
    box.style.display = "none";
  }, 3000);
}


